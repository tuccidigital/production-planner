{
  "name": "tucci-planejador-producao",
  "version": "1.0.0",
  "private": true,
  "description": "P07 · Planejador de Produção (Code App do Power Apps em React + TypeScript). Portfólio Tucci Digital — dados fictícios da Lumina Componentes.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
